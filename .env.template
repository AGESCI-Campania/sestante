# .env.template — Sestante (Authentik)
# Copiare in .env e valorizzare. NON committare mai .env con valori reali.

# --- Database ---
PG_PASS=                     # openssl rand -base64 36 | tr -d '\n'
PG_USER=authentik
PG_DB=authentik

# --- Authentik core ---
AUTHENTIK_SECRET_KEY=        # openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# --- Versione immagine (mai :latest, è deprecato) ---
# Verificare l'ultima versione stabile su https://docs.goauthentik.io/releases/ prima del deploy
AUTHENTIK_TAG=

# --- Porte esposte (adattare in base al reverse proxy scelto, come per Plancia) ---
# Nomi confermati sul compose ufficiale versione 2026.x
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# --- Bootstrap primo amministratore (opzionale, per deploy automatizzato) ---
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# --- Email globale (notifiche, recupero accesso) ---
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=sestante@agescicampania.org
