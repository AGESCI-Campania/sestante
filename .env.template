# .env.template — Sestante (Authentik)
# Copiare in .env e valorizzare. NON committare mai .env con valori reali.

# --- Database ---
PG_PASS=                     # openssl rand -base64 36 | tr -d '\n'
PG_USER=authentik
PG_DB=authentik

# --- Authentik core ---
AUTHENTIK_SECRET_KEY=        # openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# --- Versione immagine (mai :latest, è deprecato) ---
# Verificare l'ultima versione stabile su https://docs.goauthentik.io/releases/ prima del deploy
# (ultima verificata: 2026.8.5, 2026-11-12 — deve coincidere col default in docker-compose.yml)
AUTHENTIK_TAG=2026.8.5

# --- URL pubblico (introdotto in 2026.8, obbligatorio da 2026.11) ---
# Solo schema + host, senza path. Usato anche per i link nelle email.
AUTHENTIK_WEB__BASE_URL=https://auth.agescicampania.net

# --- Porte esposte ---
# Solo su 127.0.0.1, per debug dal server (curl http://127.0.0.1:9000/-/health/live/).
# Il traffico pubblico arriva da Caddy sulla rete Docker agesci-proxy (docker-compose.override.yml).
COMPOSE_PORT_HTTP=127.0.0.1:9000
COMPOSE_PORT_HTTPS=127.0.0.1:9443

# --- Proxy fidati (2026.8+) ---
# Gli header X-Forwarded-* sono accettati solo da queste reti. Il default di Authentik copre
# già le reti private, incluso il container Caddy su agesci-proxy (172.16.0.0/12): non serve
# valorizzarla. Sintomi di config errata: mixed content, spinner infinito, redirect http://
# invece di https://.
# AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.16.0.0/12

# --- Bootstrap primo amministratore (opzionale, per deploy automatizzato) ---
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# --- Email globale (notifiche, recupero accesso) ---
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=sestante@agescicampania.net

# --- Backup notturno (scripts/backup.sh, timer systemd sestante-backup.timer) ---
# Commentate = valori di default. Vedi docs/BACKUP.md.
# Cartella degli archivi (relativa al repo o assoluta) e giorni di conservazione sul server.
# Se si decommentano, niente commenti sulla stessa riga del valore.
# BACKUP_DIR=backups
# BACKUP_GIORNI=14
